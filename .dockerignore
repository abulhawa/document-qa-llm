# Ignore cache and temp files
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.sqlite3

# Git-related files
.git
.gitignore
.gitattributes

# Ignore OS-generated files
.DS_Store
Thumbs.db

# Ignore IDE settings
.vscode/
.idea/

# Ignore system envs and secrets
.env
.env.*

# Ignore test output
*.out
*.tmp

# Ignore large or raw data
data/
datasets/
downloads/
opensearch-backups/
qdrant-snapshots/
.venv/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
# The worker image currently has no runtime imports from these directories.
tests/
docs/
assets/
*.pem
*.key
*.p12
*.pfx
models/
sample_docs/
