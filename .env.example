# Copy to .env. Values are non-secret local-development defaults.
# Never commit .env or real credentials.

# Host document directory mounted read-only into the Celery container.
DOCUMENTS_PATH=./sample_docs
WORKER_DOCUMENTS_PATH=/documents
LOCAL_SYNC_ROOT=./sample_docs

# Mode, index isolation, and logging
NAMESPACE=dev
INDEX_PREFIX=
INDEX_SUFFIX=
TEST_MODE=off
LOG_LEVEL=INFO

# Local data/model endpoints
OPENSEARCH_URL=http://localhost:9200
QDRANT_URL=http://localhost:6333
EMBEDDING_API_URL=http://localhost:8000/embed
RERANK_API_URL=http://localhost:8000/rerank
LLM_BASE_URL=http://localhost:5000
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# LLM provider. Groq is optional and sends prompt/context data off-host.
USE_GROQ=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=llama-3.3-70b-versatile
# Override these for OpenAI-compatible servers without text-generation-webui internals.
LLM_GENERATE_ENDPOINT=http://localhost:5000/api/v1/generate
LLM_COMPLETION_ENDPOINT=http://localhost:5000/v1/completions
LLM_CHAT_ENDPOINT=http://localhost:5000/v1/chat/completions
LLM_MODEL_LIST_ENDPOINT=http://localhost:5000/v1/internal/model/list
LLM_MODEL_LOAD_ENDPOINT=http://localhost:5000/v1/internal/model/load
LLM_MODEL_INFO_ENDPOINT=http://localhost:5000/v1/internal/model/info

# Namespaced storage names
CHUNKS_INDEX_BASE=documents
FULLTEXT_INDEX_BASE=documents_full_text
FINANCIAL_RECORDS_INDEX_BASE=financial_records
INGEST_LOG_INDEX_BASE=ingest_logs
WATCH_INVENTORY_INDEX_BASE=watch_inventory
WATCHLIST_INDEX_BASE=watchlists
QDRANT_COLLECTION_BASE=document_chunks
QDRANT_FILE_VECTORS_COLLECTION_BASE=file_vectors

# Celery client defaults used by host-side administration pages
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_QUEUES=ingest,celery
CELERY_SERVICE=celery

# Embedding service/model and chunking. EMBEDDING_SIZE must match the model.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_SIZE=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_REQ_MAX_CHUNKS=64
EMBEDDING_DEVICE=cuda
EMBEDDING_FP16=true
CHUNK_SIZE=800
CHUNK_OVERLAP=100
CHUNK_SCORE_THRESHOLD=0.75

# Optional cross-encoder reranker (disabled by default)
RETRIEVAL_ENABLE_RERANK=false
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_DEVICE=cuda
RERANK_TOP_N_DEFAULT=5
RETRIEVAL_RERANK_TOP_N=5
RETRIEVAL_RERANK_CANDIDATE_POOL=20
RETRIEVAL_RERANK_TIMEOUT_CONNECT=2.0
RETRIEVAL_RERANK_TIMEOUT_READ=30.0

# QA planning, grounding, and retrieval-to-prompt handoff
USE_STUB_EMBEDDER=false
USE_STUB_LLM=false
QA_GROUNDING_ENABLED=false
QA_GROUNDING_THRESHOLD=0.30
QA_ENABLE_QUERY_PLANNING=false
QA_ENABLE_HYDE=false
QA_HANDOFF_POLICY=dynamic
QA_HANDOFF_FIXED_TOP_K=5
QA_HANDOFF_DYNAMIC_RETRIEVAL_TOP_K=7
QA_HANDOFF_DYNAMIC_TOKEN_BUDGET=1200
QA_HANDOFF_DYNAMIC_MIN_CHUNKS=3
# 0 means no hard max; token budget and minimum chunk settings control packing.
QA_HANDOFF_DYNAMIC_MAX_CHUNKS=0

# Ingestion/deletion/request controls
INGEST_MAX_WORKERS=8
INGEST_IO_CONCURRENCY=8
INGEST_MAX_FAILURES=10
OPENSEARCH_DELETE_BATCH=1024
QDRANT_DELETE_BATCH=64
OPENSEARCH_REQUEST_TIMEOUT=60

# LLM response cache. Prompt text can contain private document context.
LLM_CACHE_BACKEND=opensearch
LLM_CACHE_ENABLED=true
LLM_CACHE_INDEX=llm_cache_v1
LLM_CACHE_STORE_PROMPT_TEXT=true
LLM_CACHE_TTL_DAYS=30
